{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid"]
    },
    "InvoiceRecord": {
      "title": "Invoice Record",
      "description": "Invoice record document",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "createdAt": { "type": "string" },
        "data": { "type": "object" }
      },
      "required": ["id"]
    },
    "CustomerRecord": {
      "title": "Customer Record",
      "description": "Customer record document",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" }
      },
      "required": ["id"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile document"
    },
    "/users/{userId}/invoices/{invoiceId}": {
      "schema": { "$ref": "#/entities/InvoiceRecord" },
      "description": "User specific invoices collection"
    },
    "/users/{userId}/customers/{customerId}": {
      "schema": { "$ref": "#/entities/CustomerRecord" },
      "description": "User specific customers collection"
    }
  }
}
